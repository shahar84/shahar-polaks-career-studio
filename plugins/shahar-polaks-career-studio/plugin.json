{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "shahar-polaks-career-studio",
  "version": "0.7.1",
  "description": "Truthful, ATS-safe CV, LinkedIn, job-match, interview-pitch, and STAR-method support.",
  "homepage": "https://www.shaharpolak.com/",
  "repository": "https://github.com/shahar84/shahar-polaks-career-studio",
  "license": "LicenseRef-Shahar-Polak-Personal-Use-1.0",
  "keywords": [
    "career",
    "cv",
    "resume",
    "ats",
    "linkedin",
    "interview",
    "hebrew",
    "israel"
  ],
  "author": {
    "name": "Shahar Polak",
    "url": "https://www.shaharpolak.com/"
  },
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Shahar Polak Career Studio",
        "shortDescription": "CVs, LinkedIn and interviews",
        "longDescription": "A public-beta bilingual workflow for evidence-based CV tailoring, LinkedIn optimization, job analysis, interview pitches, STAR answers, and interview preparation.",
        "developerName": "Shahar Polak",
        "category": "Productivity",
        "capabilities": [
          "Interactive",
          "Write"
        ],
        "websiteURL": "https://www.shaharpolak.com/",
        "privacyPolicyURL": "https://github.com/shahar84/shahar-polaks-career-studio/blob/main/plugins/shahar-polaks-career-studio/PRIVACY.md",
        "termsOfServiceURL": "https://github.com/shahar84/shahar-polaks-career-studio/blob/main/LICENSE",
        "defaultPrompt": [
          "Tailor my CV truthfully for this role.",
          "Analyze my CV against this job posting.",
          "Improve my LinkedIn profile for my target role."
        ],
        "logo": "./assets/shahar-career-studio-logo.jpeg",
        "composerIcon": "./assets/shahar-career-studio-logo.jpeg"
      },
      "apps": "./.app.json"
    }
  }
}
